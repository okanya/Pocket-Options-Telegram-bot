APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://pocket_bot:change_me@localhost:5432/pocket_bot
POSTGRES_DB=pocket_bot
POSTGRES_USER=pocket_bot
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFY_CHAT_ID=

# PocketOption uses direct network/VPN by default.
# Set only if PocketOption must use an explicit HTTP/SOCKS proxy.
POCKET_OPTION_PROXY=
POCKET_OPTION_USE_ENV_PROXY=false
POCKET_OPTION_WS_URL=
POCKET_OPTION_WS_TIMEOUT_SECONDS=60
POCKET_OPTION_WS_HEARTBEAT_SECONDS=20

SIGNAL_ONLY=true
TRADING_ENABLED=false
PAPER_TRADING=false
QT_ACCOUNT_MODE=demo
REAL_TRADING_UNLOCKED=false
REAL_TRADING_ADMIN_CONFIRMED=false
ACTIVE_ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,AUDUSD_otc,EURJPY_otc
# Use one strategy name or all.
# Available: all, trend_pullback, bollinger_mean_reversion, breakout_retest
ACTIVE_STRATEGY=trend_pullback
TRADE_AMOUNT=1
EXPIRATION_SECONDS=60
TIMEFRAME_SECONDS=60

MAX_TRADES_TOTAL_PER_DAY=5
MAX_TRADES_PER_ASSET_PER_DAY=1
MAX_OPEN_TRADES_TOTAL=1
MAX_OPEN_TRADES_PER_ASSET=1
MAX_LOSSES_PER_DAY=2
MAX_CONSECUTIVE_LOSSES=2
DAILY_STOP_LOSS=10
DAILY_TAKE_PROFIT=20
MIN_PAYOUT=0.7
ONE_TRADE_PER_CANDLE=true
ONE_TRADE_PER_ASSET=true
LOSS_COOLDOWN_SECONDS=900
ASSET_COOLDOWN_SECONDS=300
